# NIDO PJB — variables de entorno
#
# Copiar a .env.local para desarrollo. En producción se configuran en el
# panel del alojamiento (Vercel → Settings → Environment Variables).

# ---------------------------------------------------------------------------
# Supabase — panel del proyecto → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el script de migración del histórico, que se ejecuta a mano.
# NUNCA se expone al navegador ni se usa en rutas de servidor: éstas actúan
# con el token del usuario para que RLS siga gobernando (contracts/api.md).
# NO configurar esta variable en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Dominio del sitio
# ---------------------------------------------------------------------------
#
# En producción DEBE ser el dominio real, con https y SIN barra final.
# De ella dependen cuatro cosas (ver lib/sitio.ts):
#
#   1. El enlace de acceso por correo. Si esto apunta a localhost, NADIE
#      puede entrar desde el dominio real y no hay ningún error visible.
#   2. Las vistas previas al compartir un enlace por WhatsApp.
#   3. El sitemap y el robots.txt.
#   4. Las URL canónicas para buscadores.
#
# Desarrollo:
NEXT_PUBLIC_URL_SITIO=http://localhost:3000
#
# Producción:
# NEXT_PUBLIC_URL_SITIO=https://institutopedrojustoberrio.com
